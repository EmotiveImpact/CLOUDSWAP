  "licence": "BSD-3-Clause",
  "changes": [
    "RPC record maximum 128 KiB and read deadline",
    "XDR byte/string and integer vector allocation bounds",
    "Eight accepted connections and serial RPC processing per connection",
    "Two-entry reply queue",
    "NFS WRITE count validation",
    "NFS COMMIT invokes a backend checkpoint",
    "Independent bounded TCP receive, processing and reply flows prevent pipelined-write deadlock",
    "Persist exclusive CREATE verifiers through a backend callback",
    "Atomic GUARDED CREATE callback avoids lookup/create races",
    "FSSTAT uses backend quotas rather than fabricated 1 TiB capacity"
  ],
